RewriteEngine On
RewriteBase /

# Force HTTPS (WebGPU needs a secure context).
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# CORS proxy for public NOAA/NWS hosts (PHP port of server/proxy.mjs).
RewriteRule ^proxy/ proxy.php [L,END]

AddType application/wasm .wasm
AddType text/javascript .js .mjs
AddType application/octet-stream .bin

<IfModule mod_headers.c>
  # Hashed build assets never change; index.html must always be revalidated.
  <FilesMatch "\.(js|css|wasm|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
