{
  "name": "cwrv3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CWRV3: local WebGPU weather workstation with thirteen section tabs over public NOAA/NWS data and worldwide radar and satellite mosaics.",
  "scripts": {
    "dev": "node tools/wasm.mjs && vite --host 127.0.0.1",
    "build": "node tools/wasm.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "node server/serve.mjs",
    "deploy": "npm run build && npx wrangler@4 pages deploy dist --project-name cwrv3 --branch main",
    "test": "node tools/wasm.mjs && vitest run",
    "check": "node tools/wasm.mjs && tsc --noEmit && vitest run && vite build",
    "wasm": "node tools/wasm.mjs",
    "loc": "node tools/loc.mjs",
    "gis": "tsx tools/fetch-gis.ts",
    "bench": "node tools/perf/run-bench.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@webgpu/types": "^0.1.74",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@cornerstonejs/codec-openjpeg": "^1.3.6",
    "earcut": "^3.2.4",
    "h5wasm": "^0.10.3"
  }
}
